{
  "name": "@shieldlabs-ai/js",
  "version": "1.0.0",
  "description": "Browser loader for ShieldLabs device intelligence: loads the hosted agent from the ShieldLabs CDN and returns a request ID for every identification.",
  "keywords": [
    "shieldlabs",
    "device-intelligence",
    "fraud-detection",
    "risk-score",
    "identification",
    "fingerprinting",
    "visitor-identification"
  ],
  "homepage": "https://docs.shieldlabs.ai",
  "bugs": {
    "url": "https://github.com/ShieldLabs-ai/shieldlabs-js/issues",
    "email": "contact@shieldlabs.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShieldLabs-ai/shieldlabs-js.git"
  },
  "license": "MIT",
  "author": "ShieldLabs Inc. <contact@shieldlabs.ai>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/shieldlabs.iife.js",
  "jsdelivr": "./dist/shieldlabs.iife.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:browser": "npm run build && vitest run --config vitest.browser.config.ts",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "~3.2.7",
    "eslint": "~9.39.5",
    "happy-dom": "^20.14.5",
    "playwright-core": "1.63.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "~6.4.3",
    "vitest": "~3.2.7"
  }
}
